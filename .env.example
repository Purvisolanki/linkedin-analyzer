# Server Configuration
PORT=5000
NODE_ENV=development

# LinkedIn Session Authentication (Extract from logged-in browser cookies)
# li_at: Main LinkedIn session authentication cookie
# JSESSIONID: CSRF session cookie (usually formatted as "ajax:1234567890")
LINKEDIN_LI_AT=your_li_at_cookie_here
LINKEDIN_JSESSIONID="ajax:your_jsessionid_cookie_here"
LINKEDIN_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"

# MongoDB Database (Optional - defaults to high-speed in-memory cache if omitted)
# MONGODB_URI=mongodb://localhost:27017/linkedin_scraper
